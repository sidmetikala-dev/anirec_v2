# Copy this file to .env and fill in your own credentials.
CLIENT_ID=
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL_DEV=
DATABASE_URL_PROD=
GEMINI_API_KEY_BILLED=
GEMINI_API_KEY_UNBILLED=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY_UNBILLED=
GROQ_MODEL=openai/gpt-oss-20b
LLM_PROVIDER=gemini
LLM_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Select gemini-unbilled, gemini-billed, or groq-unbilled; restart the backend.
# API_KEY_MODE selects the provider. Leave LLM_MODEL blank to use its model above.
API_KEY_MODE=gemini-unbilled
